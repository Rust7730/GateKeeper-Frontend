---
import type { Language } from '../data/english';

interface Props { lang: Language }

const { lang } = Astro.props;
const t = (es: string, en: string) => lang === 'en' ? en : es;
const phases = [
  {
    id: 'inspeccion',
    title: t("Abre el PDF y encuentra lo que esconde.", "Open the PDF and see what it hides."),
    description: t("Gatekeeper comprueba que el archivo sea un PDF y busca contenido activo. En este ejemplo encuentra JavaScript que podría ejecutarse al abrirlo.", "Gatekeeper verifies that the file is a PDF and checks for active content. In this example it finds JavaScript that could run when the file is opened."),
  },
  {
    id: 'reconstruccion',
    title: t("Entrega una copia reconstruida.", "Deliver a reconstructed copy."),
    description: t("La reconstrucción elimina el JavaScript, las acciones automáticas y los adjuntos. Si la copia supera los controles, tu aplicación puede descargarla.", "Reconstruction removes JavaScript, automatic actions and attachments. Your application can download the copy once it passes the checks."),
  },
];
---

<section class="story wrap" data-file-story aria-labelledby="landing-title">
  <div class="story-intro">
    <p class="eyebrow">{t("Inspección y reconstrucción de archivos", "File inspection and reconstruction")}</p>
    <h1 id="landing-title" data-scroll-title="hero">{t("Mira ", "Look ")}<span class="brush">{t("dentro", "inside")}</span>{t(" antes de guardar.", " before you store.")}</h1>
    <p>{t("Gatekeeper inspecciona los archivos que recibe tu aplicación, elimina contenido activo y entrega una copia reconstruida si supera los controles.", "Gatekeeper inspects files sent to your application, removes active content and delivers a reconstructed copy once it passes the checks.")}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#integracion">{t("Ver la integración", "See the integration")} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="#inspeccion">{t("Ver qué hay en el archivo", "See what’s inside")} <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <figure class="file-stage" data-file-stage data-state="received" aria-hidden="true">
    <div class="stage-header">
      <span>{t("tarea-final.pdf", "final-assignment.pdf")}</span>
      <span class="stage-label">{t("PDF de ejemplo", "Example PDF")}</span>
    </div>
    <svg class="file-illustration" viewBox="0 0 560 430" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="doc-front" x1="156" y1="90" x2="386" y2="352" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FCFCFD" />
          <stop offset="1" stop-color="#B8D0FF" />
        </linearGradient>
        <linearGradient id="doc-sheet" x1="178" y1="91" x2="370" y2="364" gradientUnits="userSpaceOnUse">
          <stop stop-color="#E8F2FF" />
          <stop offset="1" stop-color="#89B1FF" />
        </linearGradient>
        <radialGradient id="doc-glow" cx="0" cy="0" r="1" gradientTransform="translate(273 240) rotate(90) scale(190 240)" gradientUnits="userSpaceOnUse">
          <stop stop-color="#1A67FD" stop-opacity=".38" />
          <stop offset="1" stop-color="#1A67FD" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="beam-grad" x1="0" y1="0" x2="0" y2="1">
          <stop stop-color="#46D8FF" stop-opacity="0" />
          <stop offset=".82" stop-color="#46D8FF" stop-opacity=".38" />
          <stop offset="1" stop-color="#9BEBFF" />
        </linearGradient>
        <clipPath id="doc-clip"><use href="#file-outline" /></clipPath>
        <path id="file-outline" d="M179 73h154l63 63v196a19 19 0 0 1-19 19H179a19 19 0 0 1-19-19V92a19 19 0 0 1 19-19Z" />
        <path id="file-fold" d="M333 74v44a19 19 0 0 0 19 19h43" />
        <g id="bug">
          <path d="M-11-13l-6-7m28 7 6-7M-16-6l-10-5m10 11h-12m12 7-10 5m42-18 10-5M16 0h12M16 7l10 5M0-8v25" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" />
          <path d="M-8-8v-4a8 8 0 0 1 16 0v4" stroke="currentColor" stroke-width="2.3" />
          <rect x="-16" y="-8" width="32" height="26" rx="12" stroke="currentColor" stroke-width="2.3" />
        </g>
      </defs>
      <ellipse cx="280" cy="230" rx="250" ry="198" fill="url(#doc-glow)" />
      <ellipse class="stage-shadow" cx="280" cy="355" rx="161" ry="27" />
      <path d="M70 115V79h38m344 0h38v36M70 315v36h38m344 0h38v-36" class="stage-corners" stroke-width="1.2" />
      <g class="art-float">
      <g class="art-sheet">
        <use href="#file-outline" fill="url(#doc-sheet)" class="doc-edge" stroke-width="1.4" />
        <use href="#file-fold" stroke="#315C9F" stroke-width="1.4" />
        <path d="M197 174h148m-148 18h114m-114 82h126m-126 18h92" stroke="#3765AB" stroke-opacity=".64" stroke-width="3" stroke-linecap="round" />
        <rect class="art-flag-fill" x="195" y="210" width="162" height="44" rx="8" fill="#1D2130" />
        <path class="art-flag" pathLength="100" d="M187 220v-18h18M347 202h18v18M365 244v18h-18M205 262h-18v-18" stroke="#FF7A59" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
        <rect class="art-flag-pulse" x="191" y="206" width="170" height="52" rx="11" stroke="#FF7A59" stroke-width="1.5" />
        <text x="208" y="238" fill="#FFCEB2" font-size="18" font-family="IBM Plex Mono, monospace">/JavaScript</text>
      </g>
      <g class="art-cover">
        <use href="#file-outline" fill="url(#doc-front)" class="doc-edge" stroke-width="1.4" />
        <use href="#file-fold" fill="#A9C5F8" stroke="#618BD0" stroke-width="1.4" />
        <rect x="192" y="140" width="110" height="38" rx="8" fill="#1D2130" />
        <text x="207" y="166" fill="#FCFCFD" font-size="20" font-family="IBM Plex Mono, monospace">.pdf</text>
        <path d="M194 225h164m-164 23h142m-142 23h103" stroke="#5F82BA" stroke-opacity=".66" stroke-width="3" stroke-linecap="round" />
      </g>
      <g class="art-bug bug-one" color="#FFB59D">
        <circle cx="322" cy="222" r="36" class="bug-disc" />
        <use href="#bug" x="322" y="222" />
      </g>
      <g class="art-bug bug-two" color="#FFB59D">
        <circle cx="322" cy="222" r="31" class="bug-disc" />
        <use href="#bug" x="322" y="222" />
      </g>
      <g class="art-copy">
        <use href="#file-outline" fill="url(#doc-front)" class="doc-edge" stroke-width="1.4" />
        <use href="#file-fold" fill="#A9C5F8" stroke="#618BD0" stroke-width="1.4" />
        <path d="M195 167h112m-112 22h74m-74 94h159m-159 22h124" stroke="#5F82BA" stroke-opacity=".72" stroke-width="3" stroke-linecap="round" />
        <path d="M225 230l16 16 31-34" stroke="#0B3D28" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    </svg>
    <div class="stage-footer">
      <span class="stage-state state-received">{t("Archivo recibido", "File received")}</span>
      <span class="stage-state state-open">{t("Contenido activo detectado", "Active content detected")}</span>
      <span class="stage-state state-clean">{t("Copia reconstruida", "Reconstructed copy")}</span>
      <span class="stage-track"><i></i><i></i><i></i></span>
    </div>
  </figure>

  <div class="story-steps">
    {phases.map(({ id, title, description }, index) => (
      <article class="story-step" id={id} data-phase={index === 0 ? 'open' : 'clean'}>
        <span class="step-number" aria-hidden="true">0{index + 2} / 03</span>
        <h2 data-scroll-title>{title}</h2>
        <p>{description}</p>
      </article>
    ))}
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('[data-file-story]');
  const stage = story?.querySelector<HTMLElement>('[data-file-stage]');
  const steps = [...(story?.querySelectorAll<HTMLElement>('.story-step') ?? [])];

  if (story && stage && steps.length) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pendingFrame = 0;

    const reducesMotion = () => motion.matches || document.documentElement.dataset.motion === 'reduce';

    function update() {
      pendingFrame = 0;
      if (!stage || reducesMotion()) return;

      const marker = window.innerHeight * (window.innerWidth <= 760 ? 0.76 : 0.66);
      let state = 'received';
      for (const step of steps) {
        if (step.getBoundingClientRect().top <= marker) state = step.dataset.phase ?? state;
      }
      if (stage.dataset.state !== state) stage.dataset.state = state;
    }

    function scheduleUpdate() {
      if (!pendingFrame) pendingFrame = window.requestAnimationFrame(update);
    }

    function syncMotion() {
      if (!stage) return;
      stage.dataset.state = 'received';
      window.removeEventListener('scroll', scheduleUpdate);
      window.removeEventListener('resize', scheduleUpdate);
      if (reducesMotion()) return;
      window.addEventListener('scroll', scheduleUpdate, { passive: true });
      window.addEventListener('resize', scheduleUpdate);
      update();
    }

    motion.addEventListener('change', syncMotion);
    document.addEventListener('gatekeeper:motion-change', syncMotion);
    syncMotion();
    if (document.readyState !== 'complete') window.addEventListener('load', scheduleUpdate, { once: true });
  }
</script>
