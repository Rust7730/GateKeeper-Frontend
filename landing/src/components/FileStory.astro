---
import type { Language } from '../data/english';

interface Props { lang: Language }

const { lang } = Astro.props;
const t = (es: string, en: string) => lang === 'en' ? en : es;
const phases = [
  {
    id: 'inspeccion',
    title: t("Abre el PDF y encuentra lo que esconde.", "Open the PDF and see what it hides."),
    description: t("Gatekeeper comprueba que el archivo sea un PDF y busca contenido activo. En este ejemplo encuentra JavaScript que podría ejecutarse al abrirlo.", "Gatekeeper verifies that the file is a PDF and checks for active content. In this example it finds JavaScript that could run when the file is opened."),
  },
  {
    id: 'reconstruccion',
    title: t("Entrega una copia reconstruida.", "Deliver a reconstructed copy."),
    description: t("La reconstrucción elimina el JavaScript, las acciones automáticas y los adjuntos. Si la copia supera los controles, tu aplicación puede descargarla.", "Reconstruction removes JavaScript, automatic actions and attachments. Your application can download the copy once it passes the checks."),
  },
];
---

<section class="story wrap" data-file-story aria-labelledby="landing-title">
  <div class="story-intro">
    <p class="eyebrow">{t("Inspección y reconstrucción de archivos", "File inspection and reconstruction")}</p>
    <h1 id="landing-title" data-scroll-title="hero">{t("Mira ", "Look ")}<span class="brush">{t("dentro", "inside")}</span>{t(" antes de guardar.", " before you store.")}</h1>
    <p>{t("Gatekeeper inspecciona los archivos que recibe tu aplicación, elimina contenido activo y entrega una copia reconstruida si supera los controles.", "Gatekeeper inspects files sent to your application, removes active content and delivers a reconstructed copy once it passes the checks.")}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#integracion">{t("Ver la integración", "See the integration")} <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="#inspeccion">{t("Ver qué hay en el archivo", "See what’s inside")} <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <figure class="file-stage" data-file-stage data-state="received" aria-hidden="true">
    <div class="stage-header">
      <span>{t("tarea-final.pdf", "final-assignment.pdf")}</span>
      <span class="stage-label">{t("PDF de ejemplo", "Example PDF")}</span>
    </div>
    <svg class="file-illustration" viewBox="0 0 560 430" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <path id="file-outline" d="M179 73h154l63 63v196a19 19 0 0 1-19 19H179a19 19 0 0 1-19-19V92a19 19 0 0 1 19-19Z" />
        <path id="file-fold" d="M333 76v40a19 19 0 0 0 19 19h41" />
        <g id="bug">
          <path d="M-11-13l-6-7m28 7 6-7M-16-6l-10-5m10 11h-12m12 7-10 5m42-18 10-5M16 0h12M16 7l10 5M0-8v25" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" />
          <path d="M-8-8v-4a8 8 0 0 1 16 0v4" stroke="currentColor" stroke-width="3.2" />
          <rect x="-16" y="-8" width="32" height="26" rx="12" stroke="currentColor" stroke-width="3.2" />
        </g>
      </defs>
      <path d="M70 115V79h38m344 0h38v36M70 315v36h38m344 0h38v-36" class="stage-corners" stroke-width="2" stroke-linecap="round" />
      <g class="art-float">
        <!-- Hoja de atrás (lavanda), como el documento trasero del logo -->
        <g class="art-sheet">
          <use href="#file-outline" transform="translate(8 9)" class="art-ink" />
          <use href="#file-outline" fill="#D9CDF7" class="doc-edge" stroke-width="7" stroke-linejoin="round" />
          <use href="#file-fold" class="doc-edge" stroke-width="7" stroke-linejoin="round" />
          <path d="M200 176h120M200 300h96" class="doc-edge" stroke-width="11" stroke-linecap="round" />
          <rect class="art-flag-fill" x="193" y="210" width="166" height="46" rx="12" fill="#F6C8E0" stroke="#141318" stroke-width="4" />
          <path class="art-flag" pathLength="100" d="M183 222v-22h22M347 200h22v22M369 244v22h-22M205 266h-22v-22" stroke="#C2366F" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
          <rect class="art-flag-pulse" x="187" y="204" width="178" height="58" rx="15" stroke="#C2366F" stroke-width="2.5" />
          <text x="210" y="240" fill="#141318" font-size="19" font-weight="700" font-family="IBM Plex Mono, monospace">/JavaScript</text>
        </g>
        <!-- Hoja de enfrente (blanca) con la etiqueta .pdf -->
        <g class="art-cover">
          <use href="#file-outline" transform="translate(8 9)" class="art-ink" />
          <use href="#file-outline" fill="#FCFCFD" class="doc-edge" stroke-width="7" stroke-linejoin="round" />
          <use href="#file-fold" fill="#FCFCFD" class="doc-edge" stroke-width="7" stroke-linejoin="round" />
          <rect x="196" y="132" width="104" height="40" rx="10" fill="#FFEB9C" stroke="#141318" stroke-width="4" />
          <text x="214" y="159" fill="#141318" font-size="20" font-weight="700" font-family="IBM Plex Mono, monospace">.pdf</text>
          <path d="M204 230h144M204 296h112" class="doc-edge" stroke-width="12" stroke-linecap="round" />
        </g>
        <!-- Barra de escaneo verde con la muesca del logo -->
        <g class="art-beam">
          <path d="M140 106h104c10 0 14 4 20 12s10 11 16 11 10-3 16-11 10-12 20-12h104" stroke="#FCFCFD" stroke-width="30" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M140 106h104c10 0 14 4 20 12s10 11 16 11 10-3 16-11 10-12 20-12h104" stroke="#B6EF1E" stroke-width="18" stroke-linecap="round" stroke-linejoin="round" />
        </g>
      </g>
      <g class="art-bug bug-one" color="#141318">
        <circle cx="322" cy="222" r="36" class="bug-disc" />
        <use href="#bug" x="322" y="222" />
      </g>
      <g class="art-bug bug-two" color="#141318">
        <circle cx="322" cy="222" r="31" class="bug-disc" />
        <use href="#bug" x="322" y="222" />
      </g>
      <!-- Copia reconstruida con sello de verificado -->
      <g class="art-copy">
        <use href="#file-outline" transform="translate(8 9)" class="art-ink" />
        <use href="#file-outline" fill="#FCFCFD" class="doc-edge" stroke-width="7" stroke-linejoin="round" />
        <use href="#file-fold" fill="#CDEEC4" class="doc-edge" stroke-width="7" stroke-linejoin="round" />
        <path d="M204 176h120M204 222h80M204 280h144" class="doc-edge" stroke-width="12" stroke-linecap="round" />
      </g>
      <g class="art-shield">
        <circle class="fx-ring fx-ring-1" cx="350" cy="310" r="58" stroke="#B6EF1E" stroke-width="6" />
        <circle class="fx-ring fx-ring-2" cx="350" cy="310" r="58" stroke="#B6EF1E" stroke-width="4" />
        <g class="shield-body">
          <circle cx="356" cy="318" r="38" class="art-ink" />
          <circle cx="350" cy="310" r="38" fill="#CDEEC4" stroke="#141318" stroke-width="6" />
        </g>
        <path class="shield-check" pathLength="100" d="M332 311l12 12 24-26" stroke="#141318" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
      </g>
      <!-- Destellos verdes del logo -->
      <g class="logo-sparks" stroke="#141318" stroke-width="3" stroke-linecap="round">
        <g transform="rotate(20 420 64)"><rect class="logo-spark" x="412" y="38" width="17" height="52" rx="8.5" fill="#B6EF1E" /></g>
        <g transform="rotate(48 452 98)"><rect class="logo-spark" x="444" y="72" width="17" height="52" rx="8.5" fill="#B6EF1E" /></g>
        <g transform="rotate(76 470 144)"><rect class="logo-spark" x="462" y="118" width="17" height="52" rx="8.5" fill="#B6EF1E" /></g>
      </g>
    </svg>
    <div class="stage-footer">
      <span class="stage-state state-received">{t("Archivo recibido", "File received")}</span>
      <span class="stage-state state-open">{t("Contenido activo detectado", "Active content detected")}</span>
      <span class="stage-state state-clean">{t("Copia reconstruida", "Reconstructed copy")}</span>
      <span class="stage-track"><i></i><i></i><i></i></span>
    </div>
  </figure>

  <div class="story-steps">
    {phases.map(({ id, title, description }, index) => (
      <article class="story-step" id={id} data-phase={index === 0 ? 'open' : 'clean'}>
        <span class="step-number" aria-hidden="true">0{index + 2} / 03</span>
        <h2 data-scroll-title>{title}</h2>
        <p>{description}</p>
      </article>
    ))}
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('[data-file-story]');
  const stage = story?.querySelector<HTMLElement>('[data-file-stage]');
  const steps = [...(story?.querySelectorAll<HTMLElement>('.story-step') ?? [])];

  if (story && stage && steps.length) {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pendingFrame = 0;

    const reducesMotion = () => motion.matches || document.documentElement.dataset.motion === 'reduce';

    function update() {
      pendingFrame = 0;
      if (!stage || reducesMotion()) return;

      const marker = window.innerHeight * (window.innerWidth <= 760 ? 0.76 : 0.66);
      let state = 'received';
      for (const step of steps) {
        if (step.getBoundingClientRect().top <= marker) state = step.dataset.phase ?? state;
      }
      if (stage.dataset.state !== state) stage.dataset.state = state;
    }

    function scheduleUpdate() {
      if (!pendingFrame) pendingFrame = window.requestAnimationFrame(update);
    }

    function syncMotion() {
      if (!stage) return;
      stage.dataset.state = 'received';
      window.removeEventListener('scroll', scheduleUpdate);
      window.removeEventListener('resize', scheduleUpdate);
      if (reducesMotion()) return;
      window.addEventListener('scroll', scheduleUpdate, { passive: true });
      window.addEventListener('resize', scheduleUpdate);
      update();
    }

    motion.addEventListener('change', syncMotion);
    document.addEventListener('gatekeeper:motion-change', syncMotion);
    syncMotion();
    if (document.readyState !== 'complete') window.addEventListener('load', scheduleUpdate, { once: true });
  }
</script>
